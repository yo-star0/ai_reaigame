# PostgreSQL
DATABASE_URL="postgresql://reaigame:reaigame@localhost:5432/reaigame?schema=public"

# API
API_PORT=3000
CORS_ORIGINS=""  # e.g. "https://ai-reaigame.vercel.app" (comma separated)

# Firebase Admin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# DEV bypass admin list (comma separated firebase uids treated as admin)
# Example: DEV_ADMIN_UIDS="demo-user,admin-demo"
DEV_ADMIN_UIDS="demo-user"

# LLM
# One of: stub | anthropic | gemini | bedrock | groq | ollama   (default: auto-detect)
LLM_PROVIDER=""

# Groq (free, fast Llama: https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Gemini (free tier via Google AI Studio: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Bedrock
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-sonnet-4-20250514-v1:0"

# Ollama (local only, default base URL http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
