# PostgreSQL
DATABASE_URL="postgresql://reaigame:reaigame@localhost:5432/reaigame?schema=public"

# API
API_PORT=3000
CORS_ORIGINS=""  # e.g. "https://ai-reaigame.vercel.app" (comma separated)

# Firebase Admin
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# LLM
# One of: stub | anthropic | gemini | bedrock   (default: auto-detect in that order)
LLM_PROVIDER=""

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Gemini (free tier via Google AI Studio: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Bedrock
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="anthropic.claude-sonnet-4-20250514-v1:0"
