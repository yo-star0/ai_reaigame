generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  firebaseUid    String             @unique
  displayName    String?
  isAdmin        Boolean            @default(false)
  createdAt      DateTime           @default(now())
  conversations  Conversation[]
  progress       ScenarioProgress[]
}

model Character {
  id            String         @id
  name          String
  tagline       String
  avatarUrl     String
  systemPrompt  String
  openingText   String
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  scenarios     Scenario[]
}

model Conversation {
  id                    String    @id @default(cuid())
  userId                String
  characterId           String
  affinity              Int       @default(0)
  hasSeenOpening        Boolean   @default(false)
  summary               String?
  summaryUntilMessageId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userId, characterId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  affinityDelta  Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Scenario {
  id              String             @id @default(cuid())
  slug            String             @unique
  characterId     String
  title           String
  synopsis        String
  unlockAffinity  Int                @default(0)
  published       Boolean            @default(false)
  order           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  character       Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  scenes          Scene[]
  progress        ScenarioProgress[]
}

model Scene {
  id         String   @id @default(cuid())
  scenarioId String
  key        String
  kind       String
  body       String
  nextKey    String?
  order      Int      @default(0)

  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  choices    Choice[]

  @@unique([scenarioId, key])
}

model Choice {
  id             String  @id @default(cuid())
  sceneId        String
  label          String
  affinityDelta  Int     @default(0)
  nextKey        String
  order          Int     @default(0)

  scene          Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
}

model ScenarioProgress {
  id            String    @id @default(cuid())
  userId        String
  scenarioId    String
  completedAt   DateTime?
  lastSceneKey  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario      Scenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}
