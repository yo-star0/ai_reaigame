# Deployment-time overrides. Values prefixed with EXPO_PUBLIC_ are embedded
# into the web/native bundle at build time.

# The public URL of the NestJS API (include /api/v1)
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# Optional Firebase web config. Leave blank to stay on DEV bypass.
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
